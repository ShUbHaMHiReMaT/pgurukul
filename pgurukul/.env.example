# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-generate-with-python-secrets-token-urlsafe-32

# PostgreSQL — replace with your own credentials, never commit real ones
DATABASE_URL=postgresql://username:password@localhost:5432/pgurukul

# Storage — Cloudflare R2 (leave USE_R2_STORAGE=false to use local disk instead)
USE_R2_STORAGE=false
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pgurukul
R2_PUBLIC_URL=
LOCAL_STORAGE_PATH=uploads

# Uploads
MAX_CONTENT_LENGTH=104857600

# Rate limiting / caching (optional — defaults to in-memory if unset)
REDIS_URL=
